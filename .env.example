# -----------------------------------------------------------------------------
# MinClaw Environment Configuration Example
# Copy this file to .env and replace placeholder values with your credentials.
# -----------------------------------------------------------------------------

# Telegram Bot Integration (Required if telegram channel is enabled)
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: Set bot owner ID and allowed user IDs (comma-separated numeric IDs)
TELEGRAM_OWNER_ID=your_telegram_user_id
TELEGRAM_ALLOWED_USERS=your_telegram_user_id

# Google Gemini API Key (Required for primary AI agent model)
# Supported keys: MPA_GEMINI_KEY_FREE (free tier), MPA_GEMINI_KEY, or GEMINI_API_KEY
# Obtain from Google AI Studio: https://aistudio.google.com/
MPA_GEMINI_KEY_FREE=your_gemini_api_key_here

# Google OAuth 2.0 Credentials (For "Sign in with Google" / Gmail & Calendar)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Ensure redirect URI includes: http://127.0.0.1:8787/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional: Web UI Dashboard port (default: 8787)
# NAKEDCLAW_WEB_PORT=8787

# Optional: Local Whisper binary path (e.g. Apple Silicon MLX Whisper or whisper-cli)
# WHISPER_PATH=/path/to/mlx_whisper
