{
  model: {
    provider: 'ollama',
    name: 'gpt-oss:20b-cloud',
    baseUrl: 'http://localhost:11434/v1',
  },
  workspace: '.',
  channels: {
    telegram: {
      enabled: true,
      allowFrom: [],
    },
    whatsapp: {
      enabled: false,
      allowFrom: [],
    },
    slack: {
      enabled: false,
      allowFrom: [],
    },
  },
  sessions: {
    dir: './sessions',
    maxTurns: 50,
    maxToolIterations: 50,
  },
  memory: {
    dir: './memory',
    indexFile: './memory/temporary-memory.md',
  },
  brain: {
    dir: './brain',
  },
  heartbeat: {
    enabled: false,
    cronExpr: '0 * * * *',
  },
  skills: {
    dir: './skills',
    autoSync: true,
  },
}
