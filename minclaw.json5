{
  model: {
    provider: 'agy',
    name: 'flash:medium',
    fallbacks: [
      { provider: 'google', name: 'gemini-3.5-flash-lite' },
      { provider: 'google', name: 'gemini-3.5-flash' },
      { provider: 'google', name: 'gemini-3.8-flash' },
    ],
  },
  owner: {
    channel: 'telegram',
    recipient: '', // Configured via TELEGRAM_OWNER_ID in .env or minclaw.local.json5
  },
  workspace: '.',
  channels: {
    telegram: {
      enabled: true,
      allowFrom: [], // Configured via TELEGRAM_ALLOWED_USERS in .env or minclaw.local.json5
    },
    whatsapp: {
      enabled: false,
      allowFrom: [],
    },
    slack: {
      enabled: false,
      allowFrom: [],
    },
  },
  sessions: {
    dir: './sessions',
    maxTurns: 25,
    maxToolIterations: 15,
    keepRecentTurns: 8,
    compactAfterTurns: 16,
  },
  memory: {
    dir: './memory',
    indexFile: './memory/temporary-memory.md',
  },
  brain: {
    dir: './brain',
  },
  heartbeat: {
    enabled: true,
    cronExpr: '*/15 * * * *',
  },
  skills: {
    dir: './skills',
    autoSync: true,
  },
}
