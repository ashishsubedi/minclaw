{
  "name": "minclaw",
  "version": "0.2.0",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "bin": {
    "minclaw": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "web": "bun run src/web/server.ts",
    "cli": "bun run src/cli.ts",
    "tui": "bun run src/tui/viewer.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun run lint && bun test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.2.1",
    "@types/qrcode-terminal": "^0.12.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.52.6",
    "@slack/bolt": "^4.6.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "croner": "^10.0.1",
    "grammy": "^1.39.3",
    "json5": "^2.2.3",
    "markdown-it": "^14.1.1",
    "qrcode-terminal": "^0.12.0"
  }
}
